# Copy to .env (never committed) and fill in.

# MediaWiki API endpoint. Through an SSH tunnel (recommended while the wiki is on plain HTTP):
#   ssh -p 2278 -N -L 8080:localhost:80 ubuntu@152.66.245.139
WIKI_API_URL=http://localhost:8080/api.php

# From Special:BotPasswords. The user name has the form  YourWikiUser@botname
WIKI_BOT_USER=Admin@feltolto
WIKI_BOT_PASSWORD=

# Optional: free key from https://openalex.org/settings/api (needed for larger queries)
OPENALEX_API_KEY=
